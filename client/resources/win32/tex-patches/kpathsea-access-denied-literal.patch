 /* Get long base name for name; name is assumed to be absolute.  */
+/* PaperStudio patch: an ancestor that a sandboxed process may not list
+   (ERROR_ACCESS_DENIED) keeps its literal component instead of failing.
+   Missing paths still fail; wildcard components are never accepted.  */
+static int
+literal_basename (const char * name, char * buf, int size)
+{
+  const char *p = name + strlen (name);
+  int len;
+
+  while (p > name && p[-1] != '\\' && p[-1] != ':') p--;
+  len = strlen (p);
+  if (len == 0 || len >= size || strchr (p, '*') || strchr (p, '?'))
+    return 0;
+  memcpy (buf, p, len + 1);
+  return len;
+}
+
 static int
 get_long_basename (char * name, char * buf, int size)
 {
@@ -337,6 +354,8 @@ get_long_basename (char * name, char * buf, int size)
         len = 0;
       FindClose (dir_handle);
     }
+  else if (GetLastError () == ERROR_ACCESS_DENIED)
+    len = literal_basename (name, buf, size);
   return len;
 }
 
